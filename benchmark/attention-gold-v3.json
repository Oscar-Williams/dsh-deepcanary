    },
    {
      "id": "heuristic-network-transient",
      "source": "controlled-fixture",
      "rationale": "Heuristic reachability evidence stays below an authoritative Host failure.",
      "signal": { "kind": "HOST_UNREACHABLE", "severityHint": 3, "authority": "heuristic" },
      "expected": { "level": "C2", "action": "INTERRUPT", "reasonCode": "HOST_UNREACHABLE" }
    },
    {
      "id": "low-hint-human-needed",
      "source": "controlled-fixture",
      "rationale": "The stable reason code keeps a Human Needed boundary actionable even when the provider hint is conservative.",
      "signal": { "kind": "HUMAN_QUESTION_PENDING", "severityHint": 0, "authority": "runtime" },
      "expected": { "level": "C2", "action": "INTERRUPT", "reasonCode": "HUMAN_QUESTION_PENDING" }
    },
    {
      "id": "locale-and-window-metadata",
      "source": "controlled-fixture",
      "rationale": "Presentation metadata does not change deterministic classification.",
      "signal": { "kind": "TASK_COMPLETED", "severityHint": 1, "authority": "runtime", "data": { "locale": "zh-CN", "windowState": "hidden", "viewportWidth": 360 } },
      "expected": { "level": "C1", "action": "INBOX", "reasonCode": "TASK_COMPLETED" }
    },
    {
      "id": "healthy-completion-fact",
      "source": "controlled-fixture",
      "rationale": "An explicit healthy fact is silent regardless of the reason label.",
      "signal": { "kind": "TASK_COMPLETED", "severityHint": 2, "authority": "runtime", "data": { "healthy": true } },
      "expected": { "level": "C0", "action": "IGNORE", "reasonCode": "TASK_COMPLETED" }
    },
    {
      "id": "heuristic-suspicious-completion",
      "source": "replay",
      "rationale": "Heuristic completion concerns remain actionable without acquiring Host authority.",
      "signal": { "kind": "COMPLETION_SUSPICIOUS", "severityHint": 3, "authority": "heuristic" },
      "expected": { "level": "C2", "action": "INTERRUPT", "reasonCode": "COMPLETION_SUSPICIOUS" }
    }
  ],
  "serviceScenarios": [
    {
      "id": "duplicate-events",
      "source": "controlled-fixture",
      "signals": [
        { "id": "duplicate-1", "kind": "HUMAN_APPROVAL_REQUIRED", "severityHint": 2, "authority": "runtime", "dedupeKey": "approval:duplicate" },
        { "id": "duplicate-2", "kind": "HUMAN_APPROVAL_REQUIRED", "severityHint": 2, "authority": "runtime", "dedupeKey": "approval:duplicate" }
      ],
      "expected": { "items": 1, "bundleCount": 1 }
    },
    {
      "id": "shared-root-decision-bundle",
      "source": "controlled-fixture",
      "signals": [
        { "id": "bundle-1", "kind": "TOOL_FAILURE_LOOP", "severityHint": 2, "authority": "derived", "dedupeKey": "failure:1", "bundleKey": "session:root-cause" },
        { "id": "bundle-2", "kind": "NO_MEANINGFUL_PROGRESS", "severityHint": 2, "authority": "derived", "dedupeKey": "progress:1", "bundleKey": "session:root-cause" }
      ],
      "expected": { "items": 1, "bundleCount": 2 }
    },
    {
      "id": "recovery-and-short-recurrence",
      "source": "replay",
      "signals": [
        { "id": "recurrence-stall", "kind": "HOST_SUSPECTED_STALL", "severityHint": 2, "authority": "runtime", "dedupeKey": "recurrence:stall:1", "bundleKey": "session:recurrence" },
        { "id": "recurrence-recovered", "kind": "HOST_STALL_RECOVERED", "severityHint": 1, "authority": "runtime", "dedupeKey": "recurrence:recovered:1", "bundleKey": "session:recurrence" },
        { "id": "recurrence-stall-again", "kind": "HOST_SUSPECTED_STALL", "severityHint": 2, "authority": "runtime", "dedupeKey": "recurrence:stall:2", "bundleKey": "session:recurrence" }
      ],
      "expected": { "items": 2, "bundleCount": 1 }
    },
    {
      "id": "parallel-sessions",
      "source": "controlled-fixture",
      "signals": [
        { "id": "session-a", "kind": "HUMAN_QUESTION_PENDING", "severityHint": 2, "authority": "runtime", "dedupeKey": "session:a", "bundleKey": "session:a" },
        { "id": "session-b", "kind": "HUMAN_QUESTION_PENDING", "severityHint": 2, "authority": "runtime", "dedupeKey": "session:b", "bundleKey": "session:b" },
        { "id": "session-a-repeat", "kind": "HUMAN_QUESTION_PENDING", "severityHint": 2, "authority": "runtime", "dedupeKey": "session:a:repeat", "bundleKey": "session:a" }
      ],
      "expected": { "items": 2, "bundleCount": 2 }
    }
  ]
