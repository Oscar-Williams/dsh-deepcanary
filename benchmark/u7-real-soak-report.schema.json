{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepCanary real elapsed Supervisor soak report",
  "type": "object",
  "required": ["schemaVersion", "reportId", "runId", "trialId", "provenance", "stableGateUse", "pluginVersion", "policyVersion", "dsh", "startedAt", "endedAt", "elapsedHours", "checks", "resources", "identity", "rawContentPersisted", "generatedAt", "conclusion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "trialId": { "type": "string", "minLength": 1 },
    "provenance": { "const": "controlled-real-elapsed" },
    "stableGateUse": { "const": "u7-real-soak" },
    "pluginVersion": { "type": "string", "minLength": 1 },
    "policyVersion": { "type": "string", "minLength": 1 },
    "dsh": { "type": "object", "required": ["tag", "commit"], "properties": { "tag": { "type": "string", "minLength": 1 }, "commit": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "elapsedHours": { "type": "number", "minimum": 0 },
    "intervalMs": { "type": "integer", "minimum": 1000 },
    "tickCount": { "type": "integer", "minimum": 1 },
    "checks": { "type": "object", "required": ["elapsedDuration", "heartbeatObserved", "snapshotsObserved", "stateWithinBudget", "boundedSessions", "leaseReleased", "privacyBoundary", "rawContentPersisted", "interrupted"], "properties": { "elapsedDuration": { "type": "boolean" }, "heartbeatObserved": { "type": "boolean" }, "snapshotsObserved": { "type": "boolean" }, "stateWithinBudget": { "type": "boolean" }, "boundedSessions": { "type": "boolean" }, "leaseReleased": { "type": "boolean" }, "privacyBoundary": { "type": "boolean" }, "rawContentPersisted": { "const": false }, "interrupted": { "type": "boolean" } }, "additionalProperties": false },
    "resources": { "type": "object", "required": ["persistentStateBudgetBytes", "maxStateBytes", "maxStateDirectoryBytes", "finalStateBytes", "writeCount", "heartbeatCount", "wakeCount", "maxHeapUsedBytes", "heapUsedDeltaBytes", "currentHeapUsedDeltaBytes", "maxRssBytes", "rssDeltaBytes", "currentRssDeltaBytes", "restoreLatencyMs", "reconcileLatencyMs"], "properties": { "persistentStateBudgetBytes": { "type": "integer", "minimum": 1 }, "maxStateBytes": { "type": "integer", "minimum": 0 }, "maxStateDirectoryBytes": { "type": "integer", "minimum": 0 }, "finalStateBytes": { "type": "integer", "minimum": 0 }, "writeCount": { "type": "integer", "minimum": 0 }, "heartbeatCount": { "type": "integer", "minimum": 0 }, "wakeCount": { "type": "integer", "minimum": 0 }, "maxHeapUsedBytes": { "type": "integer", "minimum": 0 }, "heapUsedDeltaBytes": { "type": "integer" }, "currentHeapUsedDeltaBytes": { "type": "integer" }, "maxRssBytes": { "type": "integer", "minimum": 0 }, "rssDeltaBytes": { "type": "integer" }, "currentRssDeltaBytes": { "type": "integer" }, "restoreLatencyMs": { "type": ["number", "null"], "minimum": 0 }, "reconcileLatencyMs": { "type": ["number", "null"], "minimum": 0 } }, "additionalProperties": false },
    "identity": { "type": "object", "required": ["sourceCommit", "worktreeDirty", "packageVersion", "packageSha256", "dshTag", "dshCommit", "evaluatorVersion"], "properties": { "sourceCommit": { "type": "string", "minLength": 1 }, "worktreeDirty": { "type": "boolean" }, "packageVersion": { "type": "string", "minLength": 1 }, "packageSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "dshTag": { "type": "string", "minLength": 1 }, "dshCommit": { "type": "string", "minLength": 1 }, "evaluatorVersion": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "rawContentPersisted": { "const": false },
    "generatedAt": { "type": "string", "format": "date-time" },
    "conclusion": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
