{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepCanary Outcome Receipt",
  "description": "Privacy-safe metadata linking one attention decision to an observed local, controlled, or replay outcome. Capture provenance (`source`) and task intent (`taskOrigin`) are independent: an absent or unknown taskOrigin means unknown and must never be read as natural.",
  "type": "object",
  "required": [
    "schemaVersion",
    "receiptId",
    "attentionRef",
    "trialId",
    "source",
    "policyVersion",
    "eventClass",
    "reasonCode",
    "level",
    "action",
    "sourceAuthority",
    "opened",
    "acknowledged",
    "snoozed",
    "muted",
    "feedback",
    "laterOutcome",
    "recoveredBeforeOpen",
    "latencyBucket",
    "reviewFlags",
    "recordedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptId": { "type": "string", "pattern": "^outcome-[a-f0-9]{16}$" },
    "attentionRef": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "trialId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "source": { "enum": ["real", "controlled", "replay"] },
    "taskOrigin": {
      "description": "Task intent behind the observed work; optional so schemaVersion 1 records written before this field exists stay readable. Absent means unknown, never natural.",
      "enum": ["natural", "controlled", "replay", "unknown"]
    },
    "taskRef": {
      "description": "Opaque 16-lowercase-hex reference to the originating task; never a raw task identifier.",
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "policyVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "eventClass": { "enum": ["human-needed", "host-health", "stuck-progress", "subagent-pressure", "context-pressure", "completion"] },
    "reasonCode": { "type": "string" },
    "level": { "enum": ["C0", "C1", "C2", "C3"] },
    "action": { "enum": ["IGNORE", "INBOX", "DIGEST", "INTERRUPT", "ESCALATE"] },
    "sourceAuthority": { "enum": ["host", "runtime", "derived", "heuristic"] },
    "opened": { "type": "boolean" },
    "acknowledged": { "type": "boolean" },
    "snoozed": { "type": "boolean" },
    "muted": { "type": "boolean" },
    "feedback": { "enum": ["unrated", "useful", "not-useful"] },
    "laterOutcome": { "enum": ["unknown", "continued", "completed", "failed", "aborted", "recovered", "user-stopped"] },
    "recoveredBeforeOpen": { "type": "boolean" },
    "latencyBucket": { "enum": ["unknown", "not-opened", "under-1m", "1-5m", "5-15m", "over-15m"] },
    "reviewFlags": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "enum": ["missed-human-needed", "false-stall", "wrong-level", "duplicate-final-interrupt", "provider-error", "sink-error", "dropped-event"] }
    },
    "recordedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
