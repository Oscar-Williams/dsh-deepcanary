{
  "name": "dsh-deepcanary",
  "version": "0.1.1-rc.6",
  "description": "Know when your DeepSeek Harness tasks need you. Local alerts, quiet notifications, and a task inbox.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oscar-Williams/dsh-deepcanary.git"
  },
  "bugs": {
    "url": "https://github.com/Oscar-Williams/dsh-deepcanary/issues"
  },
  "homepage": "https://github.com/Oscar-Williams/dsh-deepcanary#readme",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs",
    "assets",
    "screenshots.json",
    "benchmark/attention-gold.json",
    "benchmark/attention-gold-v3.json",
    "benchmark/attention-quality-report.schema.json",
    "benchmark/outcome-receipt.schema.json",
    "benchmark/outcome-report.schema.json",
    "benchmark/dogfood.schema.json",
    "benchmark/dogfood-aggregate.schema.json",
    "benchmark/notification-evidence.schema.json",
    "benchmark/supervisor-smoke-report.schema.json",
    "benchmark/supervisor-soak-report.schema.json",
    "benchmark/u7-real-soak-report.schema.json",
    "benchmark/attention-candidate-promotion.schema.json",
    "benchmark/policy-replay.schema.json",
    "benchmark/policy-replay-report.schema.json",
    "benchmark/stable-gates-report.schema.json",
    "benchmark/policy-replay.json",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "attention-management",
    "agent-observability",
    "human-in-the-loop"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:alpha13": "node ./scripts/build.mjs --alpha13",
    "typecheck:alpha13": "node ./scripts/build.mjs --alpha13 --typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node ./scripts/guard-pack.mjs && npm run build && npm run verify:distribution",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "verify:environment": "node ./scripts/verify-environment.mjs",
    "verify:artifact": "node ./scripts/release-artifact.mjs",
    "verify:distribution": "node ./scripts/verify-distribution.mjs",
    "verify:release-receipt": "node ./scripts/verify-release-receipt.mjs",
    "quality:report": "npm run build && node ./scripts/generate-attention-quality-report.mjs",
    "benchmark:attention": "npm run build && node ./scripts/benchmark-attention.mjs",
    "outcomes:report": "npm run build && node ./scripts/generate-outcome-report.mjs",
    "dogfood:report": "npm run build && node ./scripts/validate-dogfood.mjs",
    "dogfood:merge": "npm run build && node ./scripts/merge-dogfood.mjs",
    "dogfood:capture": "npm run build && node ./scripts/capture-dogfood-run.mjs",
    "notification:evidence": "npm run build && node ./scripts/validate-notification-evidence.mjs",
    "adapter:smoke": "npm run build && node ./scripts/adapter-alpha5-smoke.mjs",
    "compatibility:alpha13": "node ./scripts/alpha13-compat-canary.mjs",
    "supervisor:smoke": "npm run build && node ./scripts/supervisor-smoke.mjs",
    "supervisor:soak": "npm run build && node ./scripts/supervisor-soak.mjs",
    "supervisor:process": "npm run build && node ./scripts/supervisor-process-integration.mjs",
    "supervisor:real-soak": "npm run build && node ./scripts/supervisor-real-soak.mjs",
    "candidate:evaluate": "node ./scripts/evaluate-attention-candidate.mjs",
    "replay:policy": "npm run build && node ./scripts/replay-attention-policy.mjs",
    "gate:stable": "npm run build && node ./scripts/replay-attention-policy.mjs && node ./scripts/supervisor-smoke.mjs && node ./scripts/evaluate-stable-gates.mjs",
    "gates:report": "npm run gate:stable",
    "clean": "node ./scripts/clean.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.21.5",
    "react": "^18.3.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
