{
  "name": "dsh-deepcanary",
  "version": "0.1.9-rc.1",
  "description": "Know when your DeepSeek Harness tasks need you. Local alerts, quiet notifications, and a task inbox.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oscar-Williams/dsh-deepcanary.git"
  },
  "bugs": {
    "url": "https://github.com/Oscar-Williams/dsh-deepcanary/issues"
  },
  "homepage": "https://github.com/Oscar-Williams/dsh-deepcanary#readme",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh-CN.md",
    "SECURITY.md",
    "SECURITY.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "docs/README.md",
    "docs/README.zh-CN.md",
    "docs/architecture.md",
    "docs/architecture.zh-CN.md",
    "docs/compatibility.md",
    "docs/compatibility.zh-CN.md",
    "docs/development.md",
    "docs/development.zh-CN.md",
    "docs/dsh-surface-audit.md",
    "docs/dsh-surface-audit.zh-CN.md",
    "docs/dual-host-acceptance.md",
    "docs/dual-host-acceptance.zh-CN.md",
    "docs/release-checklist.md",
    "docs/release-checklist.zh-CN.md",
    "docs/roadmap.md",
    "docs/roadmap.zh-CN.md",
    "docs/security.md",
    "docs/security.zh-CN.md",
    "docs/workspace-layout.md",
    "docs/workspace-layout.zh-CN.md",
    "assets",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "attention-management",
    "agent-observability",
    "human-in-the-loop",
    "ai-agent",
    "deepseek harness",
    "ai agent",
    "deepcanary",
    "task-inbox",
    "notifications"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:alpha13": "node ./scripts/build.mjs --alpha13",
    "typecheck:alpha13": "node ./scripts/build.mjs --alpha13 --typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node ./scripts/prepare-pack.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "verify:environment": "node ./scripts/verify-environment.mjs",
    "verify:artifact": "node ./scripts/release-artifact.mjs",
    "verify:distribution": "node ./scripts/verify-distribution.mjs",
    "quality:report": "npm run build && node ./scripts/generate-attention-quality-report.mjs",
    "benchmark:attention": "npm run build && node ./scripts/benchmark-attention.mjs",
    "outcomes:report": "npm run build && node ./scripts/generate-outcome-report.mjs",
    "dogfood:report": "npm run build && node ./scripts/validate-dogfood.mjs",
    "dogfood:merge": "npm run build && node ./scripts/merge-dogfood.mjs",
    "dogfood:capture": "npm run build && node ./scripts/capture-dogfood-run.mjs",
    "notification:evidence": "npm run build && node ./scripts/validate-notification-evidence.mjs",
    "adapter:smoke": "npm run build && node ./scripts/adapter-alpha5-smoke.mjs",
    "compatibility:alpha13": "node ./scripts/alpha13-compat-canary.mjs",
    "supervisor:smoke": "npm run build && node ./scripts/supervisor-smoke.mjs",
    "supervisor:soak": "npm run build && node ./scripts/supervisor-soak.mjs",
    "supervisor:process": "npm run build && node ./scripts/supervisor-process-integration.mjs",
    "supervisor:real-soak": "npm run build && node ./scripts/supervisor-real-soak.mjs",
    "candidate:evaluate": "node ./scripts/evaluate-attention-candidate.mjs",
    "replay:policy": "npm run build && node ./scripts/replay-attention-policy.mjs",
    "gate:stable": "npm run build && node ./scripts/replay-attention-policy.mjs && node ./scripts/supervisor-smoke.mjs && node ./scripts/evaluate-stable-gates.mjs",
    "gates:report": "npm run gate:stable",
    "clean": "node ./scripts/clean.mjs",
    "typecheck:host": "node ./scripts/build.mjs --host --typecheck",
    "adapter:host": "node ./scripts/adapter-contract.mjs",
    "background:host": "node ./scripts/background-contract.mjs",
    "reminders:host": "node ./scripts/reminders-contract.mjs",
    "settings:host": "node ./scripts/settings-contract.mjs",
    "connection:host": "node ./scripts/connection-contract.mjs",
    "verify:candidate": "node ./scripts/verify-candidate.mjs",
    "verify:docs": "node ./scripts/verify-docs.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.6-alpha.2",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-connection": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-context-menu": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-settings": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-subagent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.3",
    "@deepseek-ai/schemastery": "3.18.6-alpha.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.21.5",
    "react": "^18.3.1",
    "semver": "7.7.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-rc.5 || >=0.2.2-alpha.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Oscar Williams"
}
