{
  "name": "dsh-deepcanary",
  "version": "0.1.0-rc.3",
  "description": "Local attention supervision for DeepSeek Harness: evidence-first signals, quiet notifications, and an actionable inbox.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Oscar-Williams/dsh-deepcanary.git"
  },
  "bugs": {
    "url": "https://github.com/Oscar-Williams/dsh-deepcanary/issues"
  },
  "homepage": "https://github.com/Oscar-Williams/dsh-deepcanary#readme",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs",
    "assets",
    "screenshots.json",
    "benchmark/attention-gold.json",
    "benchmark/attention-gold-v3.json",
    "benchmark/attention-quality-report.schema.json",
    "benchmark/outcome-receipt.schema.json",
    "benchmark/outcome-report.schema.json",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "attention-management",
    "agent-observability",
    "human-in-the-loop"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build && npm run verify:distribution",
    "pack:check": "npm pack --dry-run",
    "verify:distribution": "node ./scripts/verify-distribution.mjs",
    "verify:release-receipt": "node ./scripts/verify-release-receipt.mjs",
    "quality:report": "npm run build && node ./scripts/generate-attention-quality-report.mjs",
    "benchmark:attention": "npm run build && node ./scripts/benchmark-attention.mjs",
    "outcomes:report": "npm run build && node ./scripts/generate-outcome-report.mjs",
    "clean": "node ./scripts/clean.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-settings": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-subagent": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.21.5",
    "react": "^18.3.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
